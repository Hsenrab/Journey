{
  "servers": {
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/"
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": ["--yes", "@playwright/mcp@0.0.80"]
    },
    "azure": {
      "type": "stdio",
      "command": "npx",
      "args": ["--yes", "@azure/mcp@3.0.0-beta.41", "start", "--stdio"]
    }
  }
}
